# Network watcher: every socket the test user (euid 1000) creates for the
# internet (AF_INET 2, AF_INET6 10) or raw packets (AF_PACKET 17), on 64-bit
# and 32-bit calls, successful or refused. A refused attempt is still an attempt.
-a always,exit -F arch=b64 -S socket -F a0=2 -F euid=1000 -k lb-net
-a always,exit -F arch=b64 -S socket -F a0=10 -F euid=1000 -k lb-net
-a always,exit -F arch=b64 -S socket -F a0=17 -F euid=1000 -k lb-net
-a always,exit -F arch=b32 -S socket -F a0=2 -F euid=1000 -k lb-net
-a always,exit -F arch=b32 -S socket -F a0=10 -F euid=1000 -k lb-net
-a always,exit -F arch=b32 -S socket -F a0=17 -F euid=1000 -k lb-net
# 32-bit socketcall hides the socket type in memory: any use counts.
-a always,exit -F arch=b32 -S socketcall -F euid=1000 -k lb-net
# io_uring can create sockets without the socket syscall: any use counts.
-a always,exit -F arch=b64 -S io_uring_setup -F euid=1000 -k lb-net
